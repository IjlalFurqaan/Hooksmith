{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Hooksmith": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Ssrf": {
    "AllowLoopback": true,
    "AllowPrivateNetworks": true
  }
}
